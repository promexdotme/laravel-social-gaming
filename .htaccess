Options -Indexes

# Block direct downloads even when a file exists and Laravel is bypassed.
<FilesMatch "(?i)(^\.|\.(?:sql(?:\.gz)?|zip|bak|old|orig|save|swp|log|key|pem|cert(?:\..*)?)$|^installed\.lock$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Deny access to any files with a . prefix
    RewriteRule (^\.|/\.) - [F]

    # PHP may read these locally; browsers must never access application source or runtime state.
    RewriteRule ^(?:_access|localscripts|tools|context)(?:/|$) - [F,L,NC]
    RewriteRule ^casino/(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^casino/.*\.php(?:/|$) - [F,L,NC]
    RewriteRule ^(?:casino/)?(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|server\.php)(?:/|$) - [F,L,NC]

    # Existing games request the historical filename. Serve the compiled bridge
    # without shipping the private mock-websocket source as a public file.
    RewriteRule ^js/mock-websocket\.js$ js/ws-bridge.js [L,NC]

    # Pragmatic loaders derive this path from their game URL. Keep their shared
    # operator-logo metadata reachable when the game files are present locally.
    RewriteCond %{DOCUMENT_ROOT}/games/$1/gs2c/common/games-html5/operator_logos/$2 -f
    RewriteRule ^games/([^/]+)/operator_logos/(.*)$ games/$1/gs2c/common/games-html5/operator_logos/$2 [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route clean URLs for installers
    RewriteCond %{DOCUMENT_ROOT}/install.php -f
    RewriteRule ^install$ install.php [L]
    RewriteRule ^simple-install$ SimpleInstall.php [L]

    # Prefer an existing local game file for development/source builds. Customer
    # prepacks omit the games library and therefore continue to use the CDN.
    # gs2c loaders sometimes derive a nested provider path even though the
    # package stores the same bootstrap under gs2c/{desktop|mobile}. Remap only
    # when that exact packaged file exists; otherwise preserve the CDN fallback.
    RewriteCond %{DOCUMENT_ROOT}/games/$1/gs2c/$2/$3 -f
    RewriteRule ^games/([^/]+)/gs2c/common/games-html5/games/[^/]+/[^/]+/(desktop|mobile)/(.*)$ games/$1/gs2c/$2/$3 [L]
    RewriteCond %{DOCUMENT_ROOT}/games/$1/gs2c/$2/$3 -f
    RewriteRule ^games/([^/]+)/gs2c/common/games-html5/games/[^/]+/(desktop|mobile)/(.*)$ games/$1/gs2c/$2/$3 [L]

    # Proxy all remaining /games/* requests to Hosted Games CDN.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^games/([^/]+)/gs2c/common/games-html5/games/[^/]+/[^/]+/(desktop|mobile)/(.*)$ https://clients.377.live/games/$1/gs2c/$2/$3 [P,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^games/([^/]+)/gs2c/common/games-html5/games/[^/]+/(desktop|mobile)/(.*)$ https://clients.377.live/games/$1/gs2c/$2/$3 [P,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^games/(.*)$ https://clients.377.live/games/$1 [P,L]



    # Redirect Trailing Slashes If Not A Folder...
    # ❗ but NEVER touch /games/* (avoid Apache <-> nginx slash ping-pong)
    RewriteCond %{REQUEST_URI} !^/games/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller (Laravel) for everything else...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    <FilesMatch "^(?:game-session\.js|promex-html-game\.js|cedar-client\.js|ws-bridge\.(?:js|wasm))$">
        Header set Cache-Control "no-store, max-age=0"
    </FilesMatch>
</IfModule>
